[Unit]
Description=Teleinformation compteur Linky
After=docker.service
Requires=docker.service
 
[Service]
Restart=always
ExecStartPre=-/usr/bin/docker rm -f teleinfo
EnvironmentFile=-/home/pi/teleinfo-linky-with-raspberry/.env
EnvironmentFile=-/etc/default/teleinfo
ExecStart=/usr/bin/bash -c /home/pi/teleinfo-linky-with-raspberry/command.sh
ExecStop=/usr/bin/docker stop teleinfo
 
[Install]
WantedBy=multi-user.target
